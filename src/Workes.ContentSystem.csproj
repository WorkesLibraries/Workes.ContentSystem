<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>10.0</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>Workes.ContentSystem</PackageId>
    <Version>0.4.1</Version>
    <PackageReleaseNotes>Adds entry snapshot round-tripping.</PackageReleaseNotes>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Authors>Workes</Authors>
    <Company>Workes</Company>
    <Product>Workes.ContentSystem</Product>
    <Description>Engine-neutral content-entry storage for simple streams, keyed records, and extensible application content workflows.</Description>
    <PackageTags>entries game-tools game-development chat logs</PackageTags>
    <PackageProjectUrl>https://github.com/WorkesLibraries/Workes.ContentSystem</PackageProjectUrl>
    <RepositoryUrl>https://github.com/WorkesLibraries/Workes.ContentSystem.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Copyright>Copyright (c) 2026 Workes</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\CHANGELOG.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
